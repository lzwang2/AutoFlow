<UserControl x:Class="AutoFlow.App.Views.LastCloudiaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28" MaxWidth="1000" HorizontalAlignment="Stretch">
                    <TextBlock Text="Last Cloudia" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="选择完整功能即可开始，无需打开或配置脚本。" Foreground="#667085" Margin="0,0,0,24" />
                    <Border Background="#F8FAFC" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="8" Padding="22">
                        <StackPanel>
                            <TextBlock Text="多人游戏" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="自动选房、刷新列表、准备、战斗及结算，按预置脚本完整执行。" TextWrapping="Wrap" Foreground="#475467" Margin="0,10,0,18" />
                            <TextBlock Text="{Binding GameLoadStatus}" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <WrapPanel>
                                <Button Content="▶ 开始 (F9)" Command="{Binding RunScriptCommand}" Padding="20,9" Margin="0,0,10,10" />
                                <Button Content="■ 停止 (F10)" Command="{Binding StopScriptCommand}" Padding="20,9" Margin="0,0,10,10" />
                                <Button Content="在编辑器中打开" Command="{Binding OpenGameInEditorCommand}" Padding="16,9" Margin="0,0,10,10" />
                                <Button Content="重新加载" Command="{Binding ReloadGameCommand}" Padding="16,9" Margin="0,0,0,10" />
                            </WrapPanel>
                            <TextBlock Text="请在顶部选择游戏窗口。切换页面不会停止任务。" Foreground="#667085" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="运行日志" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,10" />
                    <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="260" VerticalScrollBarVisibility="Auto" />
                    <Button Content="打开日志文件夹" Command="{Binding OpenLogFolderCommand}" HorizontalAlignment="Left" Padding="12,6" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
</UserControl>
