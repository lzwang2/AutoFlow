<UserControl x:Class="AutoFlow.App.Views.LastCloudiaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="Last Cloudia" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="选择一个完整功能，再通过统一入口开始。" Foreground="#667085" Margin="0,0,0,18" />

            <ListBox ItemsSource="{Binding LastCloudia.Modules}"
                     SelectedItem="{Binding LastCloudia.SelectedModule, Mode=TwoWay}"
                     IsEnabled="{Binding CanChangeEnvironment}"
                     BorderThickness="0" Background="Transparent" Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,14,14" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Width="430" MinHeight="155" Padding="20"
                                            Background="#F8FAFC" BorderBrush="#D7DEE8"
                                            BorderThickness="1" CornerRadius="8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#2563EB" />
                                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                            <Setter TargetName="Card" Property="Background" Value="#EFF6FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#475467" Margin="0,9,0,14" />
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="#344054" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Background="#FFFFFF" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="{Binding LastCloudia.SelectedModule.DisplayName, StringFormat=已选择：{0}}"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <WrapPanel>
                        <Button Content="▶ 开始 (F9)" Command="{Binding RunScriptCommand}" Padding="20,9" Margin="0,0,10,10" />
                        <Button Content="■ 停止 (F10)" Command="{Binding StopScriptCommand}" Padding="20,9" Margin="0,0,10,10" />
                        <Button Content="在编辑器中打开" Command="{Binding OpenGameInEditorCommand}" Padding="16,9" Margin="0,0,10,10" />
                        <Button Content="重新加载" Command="{Binding ReloadGameCommand}" Padding="16,9" Margin="0,0,0,10" />
                    </WrapPanel>
                    <TextBlock Text="请在顶部选择游戏窗口。运行期间不能切换功能卡；切换页面不会停止任务。"
                               Foreground="#667085" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="运行日志" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,10" />
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     Height="260" VerticalScrollBarVisibility="Auto" />
            <Button Content="打开日志文件夹" Command="{Binding OpenLogFolderCommand}"
                    HorizontalAlignment="Left" Padding="12,6" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
