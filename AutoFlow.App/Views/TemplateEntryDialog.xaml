<Window x:Class="AutoFlow.App.Views.TemplateEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:AutoFlow.App.Common"
        Title="选择模板" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <common:NullToBoolConverter x:Key="NullToBoolConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Prompt}" FontWeight="Bold" Margin="0,0,0,8" />

        <ListBox Grid.Row="1" x:Name="EntryListBox"
                 ItemsSource="{Binding Entries}"
                 SelectedItem="{Binding SelectedEntry}"
                 Margin="0,0,0,8"
                 SelectionMode="Single"
                 MouseDoubleClick="EntryListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="#0066CC"
                                       Width="52" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DisplayText}" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="{Binding FileName}" Foreground="#888" FontSize="11"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Foreground="#666" FontSize="11"
                                   Margin="52,2,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FilePath}" Foreground="#999" FontSize="10"
                                   Margin="52,2,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FilePath}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="80" Padding="8,4" Margin="0,0,8,0"
                    Click="OkButton_Click"
                    IsEnabled="{Binding SelectedEntry, Converter={StaticResource NullToBoolConverter}}"
                    IsDefault="True" />
            <Button Content="取消" Width="80" Padding="8,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
