<Window x:Class="AutoFlow.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AutoFlow.App.ViewModels"
        xmlns:common="clr-namespace:AutoFlow.App.Common"
        xmlns:inst="clr-namespace:AutoFlow.Core.Scripting.Instructions;assembly=AutoFlow.Core"
        Title="AutoFlow 脚本编辑器" Height="820" Width="1320"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <common:NullToBoolConverter x:Key="NullToBool" />
        <common:NullToVisibilityConverter x:Key="NullToVis" />
    </Window.Resources>

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="新建" Command="{Binding NewScriptCommand}" />
                <Button Content="打开" Command="{Binding OpenScriptCommand}" />
                <Button Content="保存" Command="{Binding SaveScriptCommand}" />
                <Button Content="另存为" Command="{Binding SaveAsScriptCommand}" />
                <Separator />
                <Button Content="▶ 运行 (F9)" Command="{Binding RunScriptCommand}" Foreground="Green" FontWeight="Bold" />
                <Button Content="■ 停止 (F10)" Command="{Binding StopScriptCommand}" Foreground="Red" FontWeight="Bold" />
            </ToolBar>
        </ToolBarTray>

        <Grid DockPanel.Dock="Top" Margin="8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="目标窗口:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" DisplayMemberPath="Title" />
            <Button Grid.Column="2" Content="刷新" Margin="6,0,0,0" Padding="10,2" Command="{Binding RefreshWindowsCommand}" />
            <ComboBox Grid.Column="3" Width="200" Margin="6,0,0,0" ItemsSource="{Binding CaptureModeNames}" SelectedItem="{Binding SelectedCaptureMode}" />
            <Button Grid.Column="4" Content="开始捕获" Margin="6,0,0,0" Padding="10,2" Command="{Binding StartCaptureCommand}" />
            <Button Grid.Column="5" Content="停止捕获" Margin="6,0,0,0" Padding="10,2" Command="{Binding StopCaptureCommand}" />
        </Grid>

        <!-- Window sizing / reference resolution. Needed to reuse assets authored at a
             non-1920x1080 size: template matching is not scale-invariant, so the window
             must be resized to the size the templates were cropped at. -->
        <Border DockPanel.Dock="Top" Background="#F7F7F7" BorderBrush="#DDD" BorderThickness="0,1,0,1"
                Padding="8,5">
            <WrapPanel>
                <TextBlock Text="当前游戏:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                          MinWidth="120" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Content="+" Command="{Binding AddGameCommand}"
                        Padding="8,2" ToolTip="添加新游戏" VerticalAlignment="Center" />

                <Separator Margin="12,0" />

                <CheckBox Content="运行前调整窗口尺寸" VerticalAlignment="Center"
                          IsChecked="{Binding ResizeWindowBeforeRun}"
                          ToolTip="按下方外框尺寸调整目标窗口（等同 AutoHotkey WinMove）" />
                <TextBlock Text="外框" VerticalAlignment="Center" Margin="12,0,4,0" />
                <TextBox Width="52" VerticalAlignment="Center"
                         Text="{Binding ResizeWidth, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="×" VerticalAlignment="Center" Margin="4,0" />
                <TextBox Width="52" VerticalAlignment="Center"
                         Text="{Binding ResizeHeight, UpdateSourceTrigger=LostFocus}" />
                <Button Content="立即调整" Margin="6,0,0,0" Padding="8,2"
                        Command="{Binding ApplyWindowSizeCommand}" />

                <Separator Margin="12,0" />

                <TextBlock Text="参考分辨率" VerticalAlignment="Center" Margin="0,0,4,0"
                           ToolTip="脚本坐标与模板所在的坐标空间，随脚本一起保存" />
                <TextBox Width="52" VerticalAlignment="Center"
                         Text="{Binding ScriptReferenceWidth, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="×" VerticalAlignment="Center" Margin="4,0" />
                <TextBox Width="52" VerticalAlignment="Center"
                         Text="{Binding ScriptReferenceHeight, UpdateSourceTrigger=LostFocus}" />
                <Button Content="← 用实测客户区" Margin="6,0,0,0" Padding="8,2"
                        Command="{Binding UseReferenceAsWindowSizeCommand}"
                        ToolTip="外框尺寸包含边框和标题栏，客户区更小；以实测值为准" />

                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666"
                           Text="{Binding MeasuredClientSize, StringFormat=实测客户区: {0}}" />
            </WrapPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock Text="{Binding StatusHint}" /></StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*" MinWidth="360" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="2.7*" MinWidth="560" />
            </Grid.ColumnDefinitions>

            <!-- SHARED PREVIEW (left column) -->
            <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" Margin="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="6" FontWeight="Bold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}预览 ({0})">
                                    <Binding Path="IsLinearMode" />
                                </MultiBinding>
                            </TextBlock.Text>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLinearMode}" Value="True">
                                            <Setter Property="Text" Value="预览 (点击拾取坐标)" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLinearMode}" Value="False">
                                            <Setter Property="Text" Value="预览 (框选匹配区域 / 拾取动作坐标)" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <CheckBox Grid.Column="1" Content="显示预览" IsChecked="{Binding ShowPreview}"
                                  Margin="0,0,6,0" VerticalAlignment="Center"
                                  ToolTip="关闭预览可节省性能，但窗口捕获仍继续运行" />
                    </Grid>
                    <Grid Grid.Row="1" Background="#222" ClipToBounds="True"
                          Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVis}}">
                        <Image x:Name="PreviewImageControl"
                               Source="{Binding PreviewImage}"
                               Stretch="Uniform"
                               MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                               MouseMove="PreviewImage_MouseMove"
                               Cursor="Cross" />
                        <Canvas x:Name="RegionOverlay" IsHitTestVisible="False">
                            <Rectangle x:Name="RegionRect" Visibility="Collapsed"
                                       Stroke="#FF3B30" StrokeThickness="1.5"
                                       StrokeDashArray="4 2"
                                       Fill="#332196F3" />
                        </Canvas>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#EEE" />

            <!-- TABBED EDITORS (right column) -->
            <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedTabIndex}" Margin="0,8,8,8" Padding="0">

                <!-- TAB 1: Linear Script Editor -->
                <TabItem Header="线性脚本编辑器">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" MinWidth="260" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="1.3*" MinWidth="260" />
                        </Grid.ColumnDefinitions>

                        <!-- Instruction list -->
                        <Grid Grid.Column="0" Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="指令列表" FontWeight="Bold" Margin="4" />

                            <StackPanel Grid.Row="1" Margin="4,0,4,4">
                                <WrapPanel>
                                    <Button Content="+点击" Command="{Binding AddClickCommand}" Margin="0,0,4,4" Padding="6,2" />
                                    <Button Content="+等待图像" Command="{Binding AddWaitImageCommand}" Margin="0,0,4,4" Padding="6,2" />
                                    <Button Content="+等待颜色" Command="{Binding AddWaitColorCommand}" Margin="0,0,4,4" Padding="6,2" />
                                    <Button Content="+等待时间" Command="{Binding AddWaitTimeCommand}" Margin="0,0,4,4" Padding="6,2" />
                                    <Button Content="+循环" Command="{Binding AddLoopCommand}" Margin="0,0,4,4" Padding="6,2" />
                                    <Button Content="+注释" Command="{Binding AddCommentCommand}" Margin="0,0,4,4" Padding="6,2" />
                                </WrapPanel>

                                <!-- Insert from the shared action-block library: a reference, not
                                     a copy, so later edits to the block reach this script too. -->
                                <TextBlock Text="从动作模板库插入 (插入的是引用)" Margin="0,4,0,2" Foreground="#0066CC" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding AvailableActionBlocks}"
                                              SelectedItem="{Binding SelectedActionBlock}"
                                              DisplayMemberPath="Id" />
                                    <Button Grid.Column="1" Content="+ 插入动作块" Margin="4,0,0,0" Padding="6,2"
                                            Command="{Binding InsertActionBlockCommand}" />
                                </Grid>

                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="📂 打开线性模板" Command="{Binding OpenLinearTemplateCommand}" Margin="0,0,4,0" Padding="6,2" />
                                    <Button Content="💾 另存为线性模板" Command="{Binding SaveLinearAsTemplateCommand}" Padding="6,2" />
                                </WrapPanel>
                            </StackPanel>

                            <ListBox Grid.Row="2" Margin="4,0"
                                     ItemsSource="{Binding Steps}"
                                     SelectedItem="{Binding SelectedStep}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Kind}" FontWeight="Bold"
                                                       Width="80" Foreground="#0066CC" />
                                            <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <WrapPanel Grid.Row="3" Margin="4">
                                <Button Content="↑ 上移" Command="{Binding MoveUpCommand}" Margin="0,0,4,0" Padding="6,2" />
                                <Button Content="↓ 下移" Command="{Binding MoveDownCommand}" Margin="0,0,4,0" Padding="6,2" />
                                <Button Content="🗑 删除" Command="{Binding RemoveInstructionCommand}" Padding="6,2" />
                            </WrapPanel>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#EEE" />

                        <!-- Properties + log -->
                        <Grid Grid.Column="2" Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1.2*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="属性" FontWeight="Bold" Margin="4" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="4">
                                <StackPanel DataContext="{Binding SelectedInstruction}"
                                            IsEnabled="{Binding Converter={StaticResource NullToBool}}">
                                    <!-- Position (Click / WaitColor) -->
                                    <StackPanel x:Name="PositionPanel">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CommandType}" Value="Click">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CommandType}" Value="WaitColor">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="坐标 (1920×1080 基准)" Margin="0,4,0,2" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding PositionX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,0" />
                                            <TextBox Grid.Column="1" Text="{Binding PositionY, UpdateSourceTrigger=PropertyChanged}" Margin="2,0,0,0" />
                                        </Grid>
                                        <Button Content="🎯 从预览拾取坐标"
                                                Command="{Binding DataContext.PickCoordinateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Margin="0,4,0,0" Padding="4,3" />
                                    </StackPanel>

                                    <!-- PLACEHOLDER_LINEAR_PROPERTIES_2 -->

                                    <!-- WaitImage -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CommandType}" Value="WaitImage">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <!-- A WaitImage step names a shared condition; it does not
                                             carry its own image, region or thresholds any more.
                                             Those are edited in the 图像条件库 tab, because one
                                             shared object with two edit paths is one nobody can
                                             reason about. -->
                                        <TextBlock Text="引用共享条件 (必填)" FontWeight="Bold"
                                                   Foreground="#0066CC" Margin="0,4,0,2" />
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableConditions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataContext.SelectedCondition, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="DisplayText" />
                                        <TextBlock Text="{Binding DataContext.SelectedStep.ConditionSummary, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="图片 / 区域 / 阈值请到「图像条件库」标签页编辑"
                                                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <Button Content="✕ 取消引用" Margin="0,4,0,0" Padding="4,2"
                                                Command="{Binding DataContext.ClearStepConditionRefCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                                        <!-- Reference-space mismatch (AC-07): the coordinates look
                                             fine but match the wrong place at runtime. -->
                                        <Border Background="#FFF4E5" BorderBrush="#E0A030" BorderThickness="1"
                                                Padding="6,4" Margin="0,6,0,0"
                                                Visibility="{Binding DataContext.HasReferenceSpaceWarning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding DataContext.ReferenceSpaceWarning, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       TextWrapping="Wrap" Foreground="#8A5000" />
                                        </Border>

                                        <!-- The timeout stays on the step, not the condition: the
                                             same condition is awaited 5s in one script and 30s in
                                             another (FR-09). -->
                                        <Separator Margin="0,8" />
                                        <TextBlock Text="超时 (ms)" Margin="0,6,0,2" />
                                        <TextBox Text="{Binding WaitTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox Content="匹配后点击中心" IsChecked="{Binding ClickAfterMatch}" Margin="0,6,0,0" />
                                    </StackPanel>

                                    <!-- PLACEHOLDER_LINEAR_PROPERTIES_3 -->

                                    <!-- WaitColor extra -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CommandType}" Value="WaitColor">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="目标颜色 (#RRGGBB)" Margin="0,6,0,2" />
                                        <TextBox Text="{Binding WaitColorHex, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="容差" Margin="0,6,0,2" />
                                        <TextBox Text="{Binding WaitColorTolerance, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="超时 (ms)" Margin="0,6,0,2" />
                                        <TextBox Text="{Binding WaitTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!-- WaitTime -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CommandType}" Value="WaitTime">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="等待时间 (ms)" Margin="0,4,0,2" />
                                        <TextBox Text="{Binding WaitTimeMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!-- Loop -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CommandType}" Value="Loop">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="跳回到指令序号 (从0开始)" Margin="0,4,0,2" />
                                        <TextBox Text="{Binding LoopBackToIndex, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="循环次数 (-1 = 无限)" Margin="0,6,0,2" />
                                        <TextBox Text="{Binding LoopCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!-- Comment -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CommandType}" Value="Comment">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="注释内容" Margin="0,4,0,2" />
                                        <TextBox Text="{Binding CommentContent, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" />
                                    </StackPanel>

                                    <!-- Common: interval to next -->
                                    <TextBlock Text="执行后延迟 (ms)" Margin="0,10,0,2" />
                                    <TextBox Text="{Binding IntervalToNextInstructionMs, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 窗口只显示最近 50 条；完整记录在日志文件里 -->
                            <DockPanel Grid.Row="2" Margin="4">
                                <Button DockPanel.Dock="Right" Content="📁 日志文件夹" Padding="8,2"
                                        FontWeight="Normal" FontSize="11"
                                        ToolTip="打开日志文件夹（窗口只显示最近 50 条，文件里是完整记录）"
                                        Command="{Binding OpenLogFolderCommand}" />
                                <TextBlock Text="日志 (最近 50 条)" FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox Grid.Row="3" Margin="4,0,4,0"
                                     Text="{Binding LogText, Mode=OneWay}"
                                     FontFamily="Consolas" FontSize="11"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True" />
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Rule Loop Editor -->
                <TabItem Header="规则循环编辑器">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="220" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="1.4*" MinWidth="300" />
                        </Grid.ColumnDefinitions>

                        <!-- Rule list -->
                        <Grid Grid.Column="0" Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="规则 (从上到下, 首个匹配生效)" FontWeight="Bold" Margin="4" TextWrapping="Wrap" />
                            <StackPanel Grid.Row="1" Margin="4,0,4,4">
                                <Button Content="+ 添加规则" Command="{Binding AddRuleCommand}" Margin="0,0,0,4" Padding="6,3" />
                                <Button Content="📥 从库导入规则" Command="{Binding ImportRuleFromTemplateCommand}" Padding="6,3" />
                            </StackPanel>
                            <ListBox Grid.Row="2" Margin="4,0" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Enabled}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="另存为模板..." Command="{Binding SaveRuleAsTemplateCommand}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                            <WrapPanel Grid.Row="3" Margin="4">
                                <Button Content="↑ 上移" Command="{Binding MoveRuleUpCommand}" Margin="0,0,4,0" Padding="6,2" />
                                <Button Content="↓ 下移" Command="{Binding MoveRuleDownCommand}" Margin="0,0,4,0" Padding="6,2" />
                                <Button Content="🗑 删除" Command="{Binding RemoveRuleCommand}" Padding="6,2" />
                            </WrapPanel>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#EEE" />

                        <!-- Detail: condition + actions + log -->
                        <Grid Grid.Column="2" Margin="0" DataContext="{Binding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1.1*" />
                            </Grid.RowDefinitions>

                            <!-- Condition editor -->
                            <ScrollViewer Grid.Row="0" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                          IsEnabled="{Binding SelectedRule, Converter={StaticResource NullToBool}}">
                                <StackPanel Margin="4">
                                    <TextBlock Text="规则条件" FontWeight="Bold" />
                                    <TextBlock Text="规则名称 (规则库中显示)" Margin="0,6,0,2" />
                                    <TextBox Text="{Binding SelectedRule.Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="规则描述 (可选)" Margin="0,6,0,2" />
                                    <TextBox Text="{Binding SelectedRule.Description, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="启用该规则" IsChecked="{Binding SelectedRule.Enabled}" Margin="0,6,0,0" />
                                    <CheckBox Content="整个运行期间只触发一次" IsChecked="{Binding SelectedRule.TriggerOnce}" Margin="0,4,0,0" />

                                    <!-- Shared condition reference: the rule names a condition,
                                         the library owns the image, region and thresholds. -->
                                    <TextBlock Text="判定条件 (共享)" FontWeight="Bold" Margin="0,8,0,2" Foreground="#0066CC" />
                                    <TextBlock Text="{Binding SelectedRule.ConditionSummary}" Foreground="#555" TextWrapping="Wrap" />
                                    <TextBlock Text="引用条件 (留空 = 无条件兜底规则)" Margin="0,6,0,2" />
                                    <ComboBox ItemsSource="{Binding AvailableConditions}"
                                              SelectedItem="{Binding SelectedCondition}"
                                              DisplayMemberPath="DisplayText" />
                                    <Button Content="✕ 清除引用 (改为兜底规则)" Command="{Binding ClearConditionRefCommand}"
                                            Margin="0,4,0,0" Padding="4,2" />

                                    <!-- Reference-space mismatch: coordinates look fine but match
                                         the wrong place at runtime, so it must be visible (AC-07). -->
                                    <Border Background="#FFF4E5" BorderBrush="#E0A030" BorderThickness="1"
                                            Padding="6,4" Margin="0,6,0,0"
                                            Visibility="{Binding HasReferenceSpaceWarning, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding ReferenceSpaceWarning}" TextWrapping="Wrap" Foreground="#8A5000" />
                                    </Border>

                                    <!-- Read-only view of the referenced condition. Editing it
                                         belongs to the 图像条件库 tab: the condition is shared, and
                                         letting each rule editor change it in place is how one
                                         rule's tweak silently breaks four others. -->
                                    <Border Background="#F7F7F7" BorderBrush="#DDD" BorderThickness="1"
                                            Padding="6,4" Margin="0,8,0,0"
                                            Visibility="{Binding SelectedCondition, Converter={StaticResource NullToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedCondition.Id}" Foreground="#777" FontFamily="Consolas" />
                                            <TextBlock Text="{Binding SelectedCondition.RegionSummary}" Foreground="#555" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding SelectedCondition.ReferenceSummary}" Foreground="#555" />
                                            <TextBlock Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Text="图片 / 区域 / 阈值请到「图像条件库」标签页编辑，改动会影响所有引用它的规则。" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- PLACEHOLDER_RULE_DETAIL_2 -->

                            <!-- Actions header + add buttons -->
                            <StackPanel Grid.Row="1" Margin="4,6,4,0">
                                <TextBlock Text="命中后执行的动作 (按顺序)" FontWeight="Bold" />
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="+点击" Command="{Binding AddClickActionCommand}" Margin="0,0,4,4" Padding="6,2" />
                                    <Button Content="+等待" Command="{Binding AddWaitTimeActionCommand}" Margin="0,0,4,4" Padding="6,2" />
                                    <Button Content="+动作块引用" Command="{Binding AddActionBlockToRuleCommand}" Margin="0,0,4,4" Padding="6,2" />
                                    <Button Content="↑" Command="{Binding MoveActionUpCommand}" Margin="0,0,4,4" Padding="8,2" />
                                    <Button Content="↓" Command="{Binding MoveActionDownCommand}" Margin="0,0,4,4" Padding="8,2" />
                                    <Button Content="🗑" Command="{Binding RemoveActionCommand}" Margin="0,0,4,4" Padding="8,2" />
                                </WrapPanel>
                                <!-- Same picker as the linear editor's, so one block can be
                                     referenced from both editors (FR-06). -->
                                <ComboBox ItemsSource="{Binding AvailableActionBlocks}"
                                          SelectedItem="{Binding SelectedActionBlock}"
                                          DisplayMemberPath="Id" Margin="0,0,0,2" />
                            </StackPanel>

                            <!-- Actions list + per-action editor -->
                            <Grid Grid.Row="2" Margin="4,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ListBox Grid.Row="0" ItemsSource="{Binding SelectedRuleActions}" SelectedItem="{Binding SelectedActionStep}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Kind}" FontWeight="Bold" Width="70" Foreground="#0066CC" />
                                                <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,4,0,0">
                                    <StackPanel DataContext="{Binding SelectedAction}"
                                                IsEnabled="{Binding Converter={StaticResource NullToBool}}">
                                        <!-- Click action -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CommandType}" Value="Click">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="点击坐标 (1920×1080 基准)" Margin="0,0,0,2" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding PositionX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,0" />
                                                <TextBox Grid.Column="1" Text="{Binding PositionY, UpdateSourceTrigger=PropertyChanged}" Margin="2,0,0,0" />
                                            </Grid>
                                            <Button Content="🎯 从预览拾取坐标"
                                                    Command="{Binding DataContext.PickActionCoordinateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Margin="0,4,0,0" Padding="4,3" />
                                        </StackPanel>
                                        <!-- WaitTime action -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CommandType}" Value="WaitTime">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="等待时间 (ms)" Margin="0,0,0,2" />
                                            <TextBox Text="{Binding WaitTimeMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <TextBlock Text="执行后延迟 (ms)" Margin="0,8,0,2" />
                                        <TextBox Text="{Binding IntervalToNextInstructionMs, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <DockPanel Grid.Row="3" Margin="4">
                                <Button DockPanel.Dock="Right" Content="📁 日志文件夹" Padding="8,2"
                                        FontWeight="Normal" FontSize="11"
                                        ToolTip="打开日志文件夹（窗口只显示最近 50 条，文件里是完整记录）"
                                        Command="{Binding OpenLogFolderCommand}" />
                                <TextBlock Text="日志 (最近 50 条)" FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox Grid.Row="4" Margin="4,0,0,0"
                                     Text="{Binding LogText, Mode=OneWay}"
                                     FontFamily="Consolas" FontSize="11"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True" />
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 3 (index 2): the image condition library — the ONLY place a condition's
                     image, region and thresholds can be edited. The script editors reference
                     conditions and show them read-only, because an image condition is the most
                     reused object in a library and two edit paths for one shared object means
                     neither can be trusted. -->
                <TabItem Header="图像条件库">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Condition list -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" FontWeight="Bold" Margin="0,0,0,4"
                                       Text="{Binding SelectedGame, StringFormat=条件列表 ({0})}" />
                            <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                                <Button Content="+ 新建条件" Padding="6,2" Margin="0,0,4,0"
                                        Command="{Binding NewConditionCommand}" />
                                <Button Content="🗑 删除" Padding="6,2" Margin="0,0,4,0"
                                        Command="{Binding DeleteConditionCommand}" />
                                <Button Content="📁 文件" Padding="6,2"
                                        Command="{Binding RevealConditionFileCommand}" />
                            </WrapPanel>
                            <ListBox Grid.Row="2" ItemsSource="{Binding LibraryConditions}"
                                     SelectedItem="{Binding SelectedLibraryCondition}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="11" />
                                            <TextBlock Text="{Binding Name}" Foreground="#555" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                      Background="Transparent" />

                        <!-- Condition editor -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Visibility="{Binding SelectedLibraryCondition, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding SelectedLibraryCondition.Id}"
                                           FontFamily="Consolas" FontWeight="Bold" Foreground="#0066CC" />
                                <TextBlock Text="Id 不可修改：改了会让所有引用它的规则和步骤失效"
                                           Foreground="#777" FontSize="11" Margin="0,2,0,0" />

                                <!-- Who is about to be affected. The only warning before editing a
                                     shared object, so it sits above the fields, not below them. -->
                                <Border Background="#FFF4E5" BorderBrush="#E0A030" BorderThickness="1"
                                        Padding="6,4" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding SelectedConditionUsageSummary}"
                                               TextWrapping="Wrap" Foreground="#8A5000" />
                                </Border>

                                <TextBlock Text="条件名称 (仅用于显示)" Margin="0,10,0,2" />
                                <TextBox Text="{Binding SelectedLibraryCondition.Name, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="描述 (可选)" Margin="0,8,0,2" />
                                <TextBox Text="{Binding SelectedLibraryCondition.Description, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="截图路径 (相对模板库根，形如 游戏名/images/xxx.png)" Margin="0,8,0,2" />
                                <TextBox Text="{Binding SelectedLibraryCondition.TemplatePath, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- Capture. Needs the preview running, which is why the hint says so
                                     rather than leaving a disabled button unexplained. -->
                                <GroupBox Header="从预览框选匹配区域" Margin="0,12,0,0">
                                    <StackPanel Margin="6">
                                        <TextBlock Foreground="#777" FontSize="11" TextWrapping="Wrap"
                                                   Text="需要先在左侧选中目标窗口并开始捕获。框选会同时更新截图、区域和参照空间。" />
                                        <TextBlock Text="截图文件名" Margin="0,8,0,2" />
                                        <TextBox Text="{Binding PendingImageName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Foreground="#777" FontSize="11" Margin="0,2,0,0"
                                                   Text="留用原文件名 = 覆盖现有截图；换个名字 = 新增一张图" />
                                        <Button Content="🖱 在预览上框选并截图" Margin="0,8,0,0" Padding="4,3"
                                                Command="{Binding StartRegionSelectCommand}" />

                                        <StackPanel Margin="0,8,0,0"
                                                    Visibility="{Binding IsConfirmingRegion, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="截图预览:" Margin="0,0,0,2" />
                                            <Border BorderBrush="#AAA" BorderThickness="1" Background="#EEE"
                                                    HorizontalAlignment="Left" Padding="2">
                                                <Image Source="{Binding PendingTemplatePreview}" Stretch="None"
                                                       MaxWidth="240" MaxHeight="160" />
                                            </Border>
                                            <WrapPanel Margin="0,4,0,0">
                                                <Button Content="✓ 确认保存" Foreground="Green" FontWeight="Bold"
                                                        Padding="8,3" Margin="0,0,6,0"
                                                        Command="{Binding ConfirmRegionCommand}" />
                                                <Button Content="✗ 重选" Foreground="#C00" Padding="8,3"
                                                        Command="{Binding ReselectRegionCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="匹配区域 (可手动微调)" Margin="0,12,0,0">
                                    <StackPanel Margin="6">
                                        <TextBlock Text="{Binding SelectedLibraryCondition.RegionSummary}" Foreground="#555" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="X1" Margin="0,0,4,2" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Y1" Margin="0,0,4,2" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="X2" Margin="0,0,4,2" />
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Y2" Margin="0,0,0,2" />
                                            <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,4,0"
                                                     Text="{Binding SelectedLibraryCondition.RegionX1, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,4,0"
                                                     Text="{Binding SelectedLibraryCondition.RegionY1, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,4,0"
                                                     Text="{Binding SelectedLibraryCondition.RegionX2, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Row="1" Grid.Column="3"
                                                     Text="{Binding SelectedLibraryCondition.RegionY2, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <TextBlock Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Text="全部填 -1 = 整帧匹配。坐标是参照空间内的像素，不是屏幕坐标。" />
                                    </StackPanel>
                                </GroupBox>

                                <!-- Reference space: FR-10. No automatic scaling, because OpenCV
                                     template matching is scale-sensitive — a rescaled region would
                                     match the wrong thing while looking correct. -->
                                <GroupBox Header="参照空间 (区域坐标是在多大的窗口下量的)" Margin="0,12,0,0">
                                    <StackPanel Margin="6">
                                        <TextBlock Text="{Binding SelectedLibraryCondition.ReferenceSummary}" Foreground="#555" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="外框宽" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding SelectedLibraryCondition.ReferenceOuterWidth, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="外框高" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding SelectedLibraryCondition.ReferenceOuterHeight, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <Button Content="用当前窗口尺寸填入" Margin="0,6,0,0" Padding="4,3"
                                                Command="{Binding UseWindowAsConditionReferenceCommand}" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="匹配阈值" Margin="0,12,0,0">
                                    <StackPanel Margin="6">
                                        <TextBlock Text="模板匹配阈值 (0-1，越高越严格)" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding SelectedLibraryCondition.MatchThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="均值差阈值 (越低越严格)" Margin="0,8,0,2" />
                                        <TextBox Text="{Binding SelectedLibraryCondition.MeanDiffThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </GroupBox>

                                <!-- Explicit save: the condition is shared, so a half-typed
                                     threshold must not reach the file other rules read. -->
                                <Button Content="💾 保存条件到条件库" Margin="0,12,0,8" Padding="6,4"
                                        FontWeight="Bold" Command="{Binding SaveConditionCommand}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- TAB 4 (index 3): the action block library. A block is a flat, ordered action
                     sequence; nested block references are not offered because the expander rejects
                     them (no cycle detection). -->
                <TabItem Header="动作块库">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" FontWeight="Bold" Margin="0,0,0,4"
                                       Text="{Binding SelectedGame, StringFormat=动作块列表 ({0})}" />
                            <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                                <Button Content="+ 新建动作块" Padding="6,2" Margin="0,0,4,0"
                                        Command="{Binding NewActionBlockCommand}" />
                                <Button Content="🗑 删除" Padding="6,2" Margin="0,0,4,0"
                                        Command="{Binding DeleteActionBlockCommand}" />
                                <Button Content="📁 文件" Padding="6,2"
                                        Command="{Binding RevealActionBlockFileCommand}" />
                            </WrapPanel>
                            <ListBox Grid.Row="2" ItemsSource="{Binding LibraryActionBlocks}"
                                     SelectedItem="{Binding SelectedLibraryActionBlock}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="11" />
                                            <TextBlock Foreground="#555" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding StepCount, StringFormat={}{0} 步}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                      Background="Transparent" />

                        <Grid Grid.Column="2"
                              Visibility="{Binding SelectedLibraryActionBlock, Converter={StaticResource NullToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="{Binding SelectedLibraryActionBlock.Id}"
                                           FontFamily="Consolas" FontWeight="Bold" Foreground="#0066CC" />
                                <TextBlock Text="Id 不可修改：改了会让所有引用它的步骤失效"
                                           Foreground="#777" FontSize="11" Margin="0,2,0,0" />
                                <TextBlock Text="名称 (仅用于显示)" Margin="0,8,0,2" />
                                <TextBox Text="{Binding SelectedLibraryActionBlock.Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="描述 (可选)" Margin="0,8,0,2" />
                                <TextBox Text="{Binding SelectedLibraryActionBlock.Description, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,12,0,4">
                                <TextBlock Text="动作序列 (按顺序执行)" FontWeight="Bold" />
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="+点击" Padding="6,2" Margin="0,0,4,0"
                                            Command="{Binding AddBlockStepClickCommand}" />
                                    <Button Content="+等待" Padding="6,2" Margin="0,0,4,0"
                                            Command="{Binding AddBlockStepWaitTimeCommand}" />
                                    <Button Content="+等待图像" Padding="6,2" Margin="0,0,4,0"
                                            Command="{Binding AddBlockStepWaitImageCommand}" />
                                    <Button Content="↑" Padding="8,2" Margin="0,0,4,0"
                                            Command="{Binding MoveBlockStepUpCommand}" />
                                    <Button Content="↓" Padding="8,2" Margin="0,0,4,0"
                                            Command="{Binding MoveBlockStepDownCommand}" />
                                    <Button Content="🗑" Padding="8,2"
                                            Command="{Binding RemoveBlockStepCommand}" />
                                </WrapPanel>
                            </StackPanel>

                            <ListBox Grid.Row="2" ItemsSource="{Binding SelectedLibraryActionBlock.Steps}"
                                     SelectedItem="{Binding SelectedBlockStep}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Kind}" FontWeight="Bold" Width="80" Foreground="#0066CC" />
                                            <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Per-step parameters -->
                            <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="0,1,0,0"
                                    Padding="0,6,0,0" Margin="0,4,0,0"
                                    Visibility="{Binding SelectedBlockStep, Converter={StaticResource NullToVis}}">
                                <StackPanel>
                                    <StackPanel DataContext="{Binding SelectedBlockAction}"
                                                Visibility="{Binding Converter={StaticResource NullToVis}}">
                                        <!-- Click -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CommandType}" Value="Click">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="点击坐标 (参照空间像素)" Margin="0,0,0,2" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Margin="0,0,2,0"
                                                         Text="{Binding PositionX, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Column="1" Margin="2,0,0,0"
                                                         Text="{Binding PositionY, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </StackPanel>
                                        <!-- WaitTime -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CommandType}" Value="WaitTime">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="等待时间 (ms)" Margin="0,0,0,2" />
                                            <TextBox Text="{Binding WaitTimeMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <!-- WaitImage: timeout only. The image itself comes from the
                                             referenced condition, edited in the 图像条件库 tab. -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CommandType}" Value="WaitImage">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="超时 (ms)" Margin="0,0,0,2" />
                                            <TextBox Text="{Binding WaitTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Content="匹配后点击中心" IsChecked="{Binding ClickAfterMatch}" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="执行后延迟 (ms)" Margin="0,8,0,2" />
                                        <TextBox Text="{Binding IntervalToNextInstructionMs, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <!-- Condition reference for the step, when its type supports one -->
                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding SelectedBlockStep.SupportsCondition, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="引用共享条件" FontWeight="Bold" Foreground="#0066CC" Margin="0,0,0,2" />
                                        <ComboBox ItemsSource="{Binding AvailableConditions}"
                                                  SelectedValue="{Binding SelectedBlockStep.ConditionRef}"
                                                  SelectedValuePath="Id" DisplayMemberPath="DisplayText" />
                                        <TextBlock Text="{Binding SelectedBlockStep.ConditionSummary}"
                                                   Foreground="#555" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button Grid.Row="4" Content="💾 保存动作块到库" Margin="0,10,0,4" Padding="6,4"
                                    FontWeight="Bold" Command="{Binding SaveActionBlockCommand}" />
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 5: Template library. One list covering all four kinds, filterable,
                     so conditions and action blocks are browsable independently of the rules
                     that happen to use them (FR-06). Browse-only; editing is in the two library
                     tabs above. -->
                <TabItem Header="模板库">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                                   Text="列出当前游戏下的全部模板。条件和动作块是被引用的共享对象，规则和线性脚本是可导入的脚本内容。" />

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="类型:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding TemplateKindFilters}"
                                      SelectedItem="{Binding SelectedTemplateKindFilter}" />
                            <Button Grid.Column="3" Content="🔄 刷新" Padding="10,3"
                                    Command="{Binding RefreshTemplateLibraryCommand}" />
                        </Grid>

                        <ListBox Grid.Row="2" ItemsSource="{Binding TemplateEntries}"
                                 SelectedItem="{Binding SelectedTemplateEntry}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding KindLabel}" Width="60" FontSize="11"
                                                       Foreground="#0066CC" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DisplayText}" FontWeight="Bold" />
                                            <!-- 文件名单独显示：下面那行完整路径是右侧省略的，
                                                 而文件名正好在最右边，最先被截掉。 -->
                                            <TextBlock Text="{Binding FileName}" Foreground="#888" FontSize="11"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="#666" FontSize="11"
                                                   Margin="60,2,0,0" TextWrapping="Wrap" />
                                        <!-- 旧格式模板照常列出（否则用户会奇怪资源管理器里有、库里没有），
                                             但要当场标明用不了，而不是等点了"使用"才报错。 -->
                                        <TextBlock Text="{Binding UnsupportedReason}" Foreground="#C05000"
                                                   FontSize="11" FontWeight="Bold" Margin="60,2,0,0"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSupportedVersion}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding FilePath}" Foreground="#AAA" FontSize="10"
                                                   Margin="60,1,0,0" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FilePath}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <TextBlock Text="{Binding SelectedTemplateHint}" Foreground="#555"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                            <WrapPanel>
                                <Button Content="📁 打开文件位置" Padding="10,4"
                                        Command="{Binding RevealSelectedTemplateCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Debug Settings Tab -->
                <TabItem Header="调试设置">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Frame Capture Debug -->
                        <GroupBox Grid.Row="0" Header="帧捕获调试" Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <CheckBox Content="启用帧捕获调试"
                                          IsChecked="{Binding EnableFrameDebug}"
                                          Margin="0,0,0,8"/>

                                <TextBlock Text="捕获模式:" Margin="0,0,0,4"/>
                                <ComboBox SelectedIndex="{Binding FrameDebugMode}" Margin="0,0,0,8">
                                    <ComboBoxItem Content="仅保存第一帧（快速检查窗口捕获）"/>
                                    <ComboBoxItem Content="仅保存匹配成功的帧（调试规则匹配）"/>
                                    <ComboBoxItem Content="仅保存无匹配的帧（排查为何所有规则都不匹配）"/>
                                </ComboBox>

                                <TextBlock Text="保存路径:" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding FrameDebugPath}"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="1"
                                            Content="浏览..."
                                            Command="{Binding BrowseFrameDebugPathCommand}"
                                            Padding="16,4"/>
                                </Grid>

                                <TextBlock Text="说明：用于调试规则匹配问题。根据实际需求选择捕获模式，避免占用过多磁盘空间。"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="Gray"
                                           FontSize="11"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Run log -->
                        <GroupBox Grid.Row="1" Header="运行日志" Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <TextBlock Text="日志文件:" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding LogFilePath, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="1"
                                            Content="📁 打开文件夹"
                                            Command="{Binding OpenLogFolderCommand}"
                                            Padding="16,4"/>
                                </Grid>

                                <TextBlock Text="说明：每次启动程序生成一个日志文件，全部日志都会写入。窗口里的日志面板只显示最近 50 条（保证滚动流畅），被顶掉的行仍在文件中——启动时的引用解析、条件库警告、参照空间不匹配提示都在这里查。"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="Gray"
                                           FontSize="11"/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
