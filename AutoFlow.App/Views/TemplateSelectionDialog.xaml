<Window x:Class="AutoFlow.App.Views.TemplateSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:AutoFlow.App.Common"
        Title="选择规则模板" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <common:NullToBoolConverter x:Key="NullToBoolConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="请选择要导入的规则模板:" FontWeight="Bold" Margin="0,0,0,8" />

        <ListBox Grid.Row="1" x:Name="TemplateListBox"
                 ItemsSource="{Binding Templates}"
                 SelectedItem="{Binding SelectedTemplate}"
                 Margin="0,0,0,8"
                 SelectionMode="Single"
                 MouseDoubleClick="TemplateListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="{Binding FileName}" Foreground="#888" FontSize="11"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Foreground="#666" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding RuleCount, StringFormat='{}规则数: {0}'}" FontSize="10" Foreground="#999" />
                            <TextBlock Text=" | " FontSize="10" Foreground="#CCC" Margin="4,0" />
                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}创建时间: {0}'}" FontSize="10" Foreground="#999" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Margin="0,0,0,8">
            <Run Text="模板目录: " FontWeight="Bold" />
            <Run Text="{Binding TemplateDirectory, Mode=OneTime}" Foreground="#666" />
        </TextBlock>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="导入" Width="80" Padding="8,4" Margin="0,0,8,0"
                    Click="ImportButton_Click"
                    IsEnabled="{Binding SelectedTemplate, Converter={StaticResource NullToBoolConverter}}"
                    IsDefault="True" />
            <Button Content="取消" Width="80" Padding="8,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
