<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- This is a WPF app; WinForms is enabled only for the System.Windows.Forms.Keys type.
         WPF reads DPI awareness from app.manifest directly, so the WinForms analyzer's
         WFAC010 ("move high-DPI settings out of the manifest") does not apply here. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>AutoFlow</AssemblyName>
    <RootNamespace>AutoFlow.App</RootNamespace>
  </PropertyGroup>

  <!-- UseWindowsForms is enabled only to reference System.Windows.Forms.Keys (the hotkey
       key type). Remove the implicit WinForms/Drawing usings it adds, otherwise Application,
       MessageBox, Point, etc. become ambiguous against their WPF/System.Drawing counterparts.
       The code accesses the type via the fully-qualified WinFormsKeys alias instead. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.Extensions" />
    <PackageReference Include="OpenCvSharp4.Windows" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoFlow.Core\AutoFlow.Core.csproj" />
    <ProjectReference Include="..\Fischless.GameCapture\Fischless.GameCapture.csproj" />
    <ProjectReference Include="..\Fischless.HotkeyCapture\Fischless.HotkeyCapture.csproj" />
    <ProjectReference Include="..\Fischless.WindowsInput\Fischless.WindowsInput.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy rule templates to output directory -->
    <Content Include="..\RuleTemplates\**\*">
      <Link>RuleTemplates\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
